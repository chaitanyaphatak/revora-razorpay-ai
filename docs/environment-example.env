# ReVora clone-safe environment example
# Copy these names into your secure local environment or deployment secret manager.
# Never commit real values to source control.

# Required for server-side Supabase access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Required only for the on-demand Gemini AI Brief workspace
GEMINI_API_KEY=replace-with-server-only-gemini-api-key

# Used only by the local schema and seed verifier; never set this to a shared or production database.
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/revora_dev
